# NVIDIA AI Service host ports (unique per project — no conflicts)
MORPHEUS_PORT=8610
DOCA_PORT=8611
NIM_PORT=8612
RAPIDS_PORT=8613
TRITON_PORT=8614
NEMO_PORT=8615

# CHAMP AI Router integration
AI_PROVIDER=champ-router
CHAMP_AI_ROUTER_URL=http://host.docker.internal:9000
CHAMP_AI_API_KEY=change-me
BACKEND_PORT=8700

# Supabase (required for auth and assessments DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
